<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The rest countdown in the status bar, and the notice when it runs out. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      The end of a rest period is an alarm in the ordinary sense: it has to land at the
      second, not whenever the system next feels like waking up. USE_EXACT_ALARM is granted
      on install and needs no prompt. It is Play-Store-restricted to alarm-like apps, which
      this qualifies as, and this app is sideloaded anyway.
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application
        android:name=".RedplateApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Redplate">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Redplate"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Not exported: the only thing that ever sends this is our own AlarmManager
          PendingIntent, which names the component explicitly.
        -->
        <receiver
            android:name=".workout.RestAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.redplate.action.REST_COMPLETE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
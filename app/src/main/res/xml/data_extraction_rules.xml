<?xml version="1.0" encoding="utf-8"?><!--
    Backup and device-transfer rules for API 31+.

    Same reasoning as backup_rules.xml: the database file is included, its `-wal` and
    `-shm` sidecars are not. Backing those up from a running app risks restoring a
    database whose WAL disagrees with its main file, which SQLite refuses to open.
    Sideloaded exercise media is excluded — it is pushed with adb and is not user data.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="redplate.db" />
        <exclude domain="database" path="redplate.db-wal" />
        <exclude domain="database" path="redplate.db-shm" />
        <exclude domain="database" path="redplate.db-journal" />
        <exclude domain="file" path="exercises" />
    </cloud-backup>

    <device-transfer>
        <include domain="database" path="redplate.db" />
        <exclude domain="database" path="redplate.db-wal" />
        <exclude domain="database" path="redplate.db-shm" />
        <exclude domain="database" path="redplate.db-journal" />
        <exclude domain="file" path="exercises" />
    </device-transfer>
</data-extraction-rules>

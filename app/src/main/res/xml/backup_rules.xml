<?xml version="1.0" encoding="utf-8"?><!--
    Android Auto Backup, for devices below API 31. See data_extraction_rules.xml for 31+.

    Only the database file itself goes up. The `-wal` and `-shm` sidecars are deliberately
    excluded: Auto Backup does not quiesce the app, so a snapshot that catches the three
    files at different moments restores a database SQLite will reject — the classic torn
    restore, and the one failure mode this project calls unrecoverable. Redplate
    checkpoints the WAL into the database when a session ends (DatabaseCheckpoint), so the
    file that is backed up carries the training that has actually been logged.

    Auto Backup is the convenience path. The JSON export in Settings is the real one.
-->
<full-backup-content>
    <include domain="database" path="redplate.db" />
    <exclude domain="database" path="redplate.db-wal" />
    <exclude domain="database" path="redplate.db-shm" />
    <exclude domain="database" path="redplate.db-journal" />
    <exclude domain="file" path="exercises" />
</full-backup-content>
